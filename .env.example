# Copy this file to `.env` and fill it in. Never commit `.env`.

# PostgreSQL connection string
#  - local (docker compose up -d):  postgresql://aeon:aeon_dev_password@localhost:5432/aeon
#  - Neon / Supabase / Hostinger VPS: paste the URL they give you (add ?sslmode=require)
DATABASE_URL="postgresql://aeon:aeon_dev_password@localhost:5432/aeon"

# Public site URL (used for canonical links, sitemap and CSRF origin checks)
# Real https domain in production (canonical links, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only read by `pnpm db:seed` to create the FIRST super admin.
# The password needs 12+ chars with upper, lower, number and symbol.
ADMIN_NAME="Site Owner"
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD=""

# Secret used to hash visitor IPs in consent records. Generate: openssl rand -hex 32
APP_SECRET=

# Cloudflare R2 (image uploads). Create a bucket, an API token with Object Read & Write,
# and enable a public domain (or r2.dev URL) for the bucket. NEVER commit real values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Optional folder inside the bucket for everything we upload (images and resumes), e.g. aeon
UPLOAD_FOLDER=

# Email (Brevo SMTP): every website form sends a notice to ADMIN_EMAIL.
# FROM_EMAIL must be a sender verified in Brevo.
FROM_EMAIL=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=
